# Vibe Lab Environment Configuration
# Full reference: docs/configuration.md
#
# CLI commands: vibelab | vibelab start | vibelab status | vibelab help | vibelab version

# =============================================================================
# SERVER
# =============================================================================
PORT=3001
VITE_PORT=5173
# Host/IP to bind servers to (default: 0.0.0.0 for all interfaces)
# Use 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0
# npm scripts reuse the launching environment. Enable login-shell import only
# when needed (for example, a GUI launcher without your shell's tool paths).
# MEDHELP_ENABLE_LOGIN_SHELL_ENV_IMPORT=1
# MEDHELP_DISABLE_LOGIN_SHELL_ENV_IMPORT=1
# CLAUDE_CLI_PATH=claude
# CURSOR_CLI_PATH=agent
# CODEX_CLI_PATH=codex

# =============================================================================
# CONTEXT WINDOW
# =============================================================================
# Optional fallback for unknown/custom models. Runtime model metadata takes precedence.
CONTEXT_WINDOW=256000
VITE_CONTEXT_WINDOW=256000


# =============================================================================
# DATABASE
# =============================================================================
# DATABASE_PATH=/path/to/custom/auth.db

# =============================================================================
# AUTHENTICATION  [SECURITY-SENSITIVE]
# =============================================================================
# IMPORTANT: Change JWT_SECRET before exposing MedHelp outside localhost!
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_SECRET=change-me-to-a-random-string
# API_KEY=

# Registration email verification with Tencent Cloud SES.
# Verification turns on automatically when all SES values below are configured.
# Set this explicitly to true to fail closed when SES configuration is missing.
# REGISTRATION_EMAIL_VERIFICATION_REQUIRED=true
# TENCENT_SES_SECRET_ID=AKID...
# TENCENT_SES_SECRET_KEY=...
# TENCENT_SES_REGION=ap-guangzhou
# TENCENT_SES_FROM=MedTimeHelp <noreply@notify.medtimehelp.com>
# TENCENT_SES_TEMPLATE_ID=123456
# TENCENT_SES_SUBJECT=MedTimeHelp 邮箱验证码
# REGISTRATION_EMAIL_CODE_TTL_MS=300000
# REGISTRATION_EMAIL_SEND_COOLDOWN_MS=60000

# =============================================================================
# PLATFORM MODE  (advanced — most users leave these commented out)
# =============================================================================
# VITE_IS_PLATFORM=false
# WORKSPACES_ROOT=/home/user/vibelab

# =============================================================================
# INTEGRATIONS  (optional)
# =============================================================================
# GEMINI_API_KEY=sk-...
# GEMINI_API_BASE_URL=https://api.go-model.com
# GOOGLE_API_KEY=AIza...  # legacy alias for image-generation integrations
# OPENAI_API_KEY=sk-...

# =============================================================================
# PI RUNTIME  (optional, server-side only)
# =============================================================================
# Prepare the isolated host first: npm run pi-runtime:prepare
# MEDHELP_PI_PROVIDER=byok-openai-compatible
# MEDHELP_PI_MODEL=provider/model-id
# MEDHELP_PI_MODEL_API=openai-completions
# MEDHELP_PI_BASE_URL=https://provider.example/v1
# MEDHELP_PI_API_KEY=server-secret
# MedHelp projects system skills plus explicitly installed per-user skills into
# the isolated Host. It never reads ~/.pi or auto-loads Pi packages/extensions.
# Set either switch to 0 to disable that projection server-wide.
# MEDHELP_PI_SKILLS_ENABLED=1
# MEDHELP_PI_MCP_ENABLED=1

# Managed-free is disabled by default. Both URLs must use HTTPS and their
# host[:port] values must be present in the allowlist. The catalog may return
# model metadata only; endpoint and credentials always come from this server.
# MEDHELP_PI_PROVIDER=managed-free
# MEDHELP_PI_MANAGED_FREE_ENABLED=true
# MEDHELP_PI_MANAGED_FREE_BASE_URL=https://inference.example/v1
# MEDHELP_PI_MANAGED_FREE_CATALOG_URL=https://catalog.example/models
# MEDHELP_PI_MANAGED_FREE_ALLOWED_HOSTS=inference.example,catalog.example
# MEDHELP_PI_MANAGED_FREE_API_KEY=server-secret
# MEDHELP_PI_MANAGED_FREE_CATALOG_TOKEN=optional-catalog-token
# MEDHELP_PI_MANAGED_FREE_MODELS=[{"id":"seed-model","api":"openai-completions"}]
# Experimental only; never enable unless the configured inference endpoint is
# intentionally anonymous and does not require an Authorization header.
# MEDHELP_PI_MANAGED_FREE_ALLOW_ANONYMOUS=false

# =============================================================================
# AGENT RUN ENGINE  (optional, server-side only)
# =============================================================================
# Shared concurrency across Claude, Codex, and Pi. Defaults to three workers.
# AGENT_WORKERS=3
# AGENT_RUN_LEASE_MS=120000
# AGENT_RUN_HEARTBEAT_MS=10000
# AGENT_RUN_REAPER_MS=15000
# AGENT_RUN_MAX_ATTEMPTS=3

# =============================================================================
# ADVANCED
# =============================================================================
# DOWNLOAD_RATE_LIMIT_MAX=30
# DOWNLOAD_RATE_LIMIT_WINDOW_MS=60000
# CLAUDE_TOOL_APPROVAL_TIMEOUT_MS=55000
