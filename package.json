{
  "name": "medhelpsec",
  "version": "1.1.21",
  "description": "AI research workspace with chat, Agent sessions, files, git, tasks, and multi-agent workflows",
  "type": "module",
  "main": "server/index.js",
  "bin": {
    "medhelpsec": "server/cli.js",
    "sec": "server/cli.js",
    "medhelp": "server/cli.js",
    "vibelab": "server/cli.js"
  },
  "files": [
    "server/",
    "shared/",
    "desktop/",
    "dist/",
    "!dist/downloads/**",
    "public/",
    "scripts/",
    "skills/",
    "!public/downloads/**",
    "!server/__tests__/**",
    "!server/data/**",
    "!server/database/*.db",
    "!server/database/*.sqlite",
    "!server/scripts/**/__pycache__/**",
    "!scripts/**/__pycache__/**",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!**/*.test.*",
    "README.md",
    "NOTICE",
    "LICENSE"
  ],
  "homepage": "https://github.com/MedTiLab/Research-Assistant",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MedTiLab/Research-Assistant.git"
  },
  "bugs": {
    "url": "https://github.com/MedTiLab/Research-Assistant/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"npm run server:watch\" \"npm run client\"",
    "server": "node scripts/ensure-native-modules.js && node server/index.js",
    "server:watch": "node scripts/ensure-native-modules.js && node scripts/watch-server.js",
    "client": "node scripts/wait-for-backend.js && vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:deepmed": "node scripts/deepmed-smoke.mjs",
    "start": "npm run build && npm run server",
    "release": "./release.sh",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/fix-node-pty.js && node scripts/install-python-tools.js && node scripts/ensure-native-modules.js --record-only",
    "desktop:deps": "node scripts/ensure-electron-native-modules.js",
    "desktop:start": "npm run desktop:offline:start",
    "desktop:offline:start": "npm run build && npm run local-engine:prepare && electron desktop/offline/main.mjs",
    "desktop:pack": "npm run desktop:dist",
    "desktop:dist": "npm run build && npm run local-engine:prepare && node scripts/packaging/package-desktop.mjs",
    "desktop:dist:mac": "npm run desktop:offline:dist:mac",
    "desktop:offline:dist:mac": "npm run build && npm run local-engine:prepare && node scripts/packaging/macos/package-online-desktop.mjs",
    "desktop:dist:win": "npm run desktop:offline:dist:win",
    "local-engine:prepare": "node scripts/build-secure-headless-kernel.mjs",
    "pi-runtime:prepare": "node --import dotenv/config scripts/prepare-pi-runtime.mjs",
    "desktop:offline:dist:win": "npm run build && npm run local-engine:prepare && node scripts/packaging/windows/package-online-desktop.mjs",
    "release:local:win": "npm run desktop:offline:dist:win",
    "release:verify:local:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/packaging/windows/verify-local-release.ps1",
    "release:verified:local:win": "npm run release:local:win && npm run release:verify:local:win",
    "release:local:offline:win": "npm run desktop:offline:dist:win",
    "release:verify:local:offline:win": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/packaging/windows/verify-local-release.ps1 -Distribution Offline",
    "release:verified:local:offline:win": "npm run release:local:offline:win && npm run release:verify:local:offline:win",
    "test": "node scripts/ensure-native-modules.js && vitest run",
    "test:watch": "node scripts/ensure-native-modules.js && vitest"
  },
  "build": {
    "appId": "com.yzglab.medhelpsec",
    "productName": "MedHelpSec",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "icon": "public/icons/app-icon.png",
    "files": [
      "dist/**/*",
      "server/**/*",
      "shared/**/*",
      "desktop/common/**/*",
      "desktop/legacy/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "desktop/legacy/main.mjs"
    },
    "mac": {
      "icon": "public/icons/app-icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "public/icons/app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "keywords": [
    "claude code",
    "ai",
    "anthropic",
    "ui",
    "mobile"
  ],
  "author": "Project Contributors",
  "license": "(GPL-3.0-only AND AGPL-3.0-only)",
  "engines": {
    "node": "20.x || 22.x || 24.x"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/merge": "^6.11.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@embedpdf/fonts-sc": "1.0.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@octokit/rest": "^22.0.0",
    "@openai/codex": "0.151.0",
    "@openai/codex-sdk": "0.151.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tailwindcss/typography": "^0.5.16",
    "@uiw/react-codemirror": "^4.23.13",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "cross-spawn": "^7.0.3",
    "docx": "^9.6.1",
    "dingtalk-stream-sdk-nodejs": "^2.0.4",
    "dompurify": "^3.4.5",
    "express": "^4.18.2",
    "fuse.js": "^7.0.0",
    "gray-matter": "^4.0.3",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "katex": "^0.16.25",
    "lucide-react": "^0.515.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.12.3",
    "mime-types": "^3.0.1",
    "multer": "^2.0.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0-beta34",
    "openai": "^6.46.0",
    "pdfkit": "^0.19.1",
    "playwright": "^1.59.1",
    "qq-official-bot": "^1.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.2.3",
    "react-i18next": "^16.5.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.1",
    "react-syntax-highlighter": "^15.6.1",
    "read-excel-file": "^9.3.10",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.1",
    "tencentcloud-sdk-nodejs-ses": "^4.1.271",
    "unpdf": "1.8.1",
    "weixin-ilink": "^0.1.0",
    "ws": "^8.14.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.7",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.6.0",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.0",
    "node-gyp": "^10.0.0",
    "postcss": "^8.4.32",
    "postject": "^1.0.0-alpha.6",
    "release-it": "^19.0.5",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.0"
  }
}
